# Celulares separados por comas. Incluye solo titulares que aceptaron aparecer
# en las consultas de esta app, tanto en Firebase como en el bot de respaldo.
TRCONTAC_NUMEROS_AUTORIZADOS=

# Proyecto y clave de la app de Firebase con permiso de lectura en Firestore.
TRCONTAC_FIREBASE_PROJECT_ID=
TRCONTAC_FIREBASE_API_KEY=

# URL HTTPS del endpoint de búsqueda del bot, sin el celular al final.
# Completa las dos variables para habilitar el respaldo.
TRCONTAC_BOT_URL=
TRCONTAC_BOT_API_KEY=
